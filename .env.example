# Copy to .env (compose reads it next to docker-compose.yml) to change a setting; the defaults are shown.

# Which published images `docker compose up` runs: a version (0.1.0-beta.126) or the moving tag `next`, see docs/self-hosting.md.
ELYSION_VERSION=next

# A second dev stack in another worktree (#890, AGENTS.md "Workflow"): the compose project name and an offset (a multiple of 10 below
# 1000) added to every host port below and to Traefik's 80. `pnpm dev:*`, `demo:check` and `test:browser` read them from here. Unset: the
# one stack `elysion` on these ports.
# ELYSION_STACK=elysion-b
# ELYSION_PORT_OFFSET=10

# Keycloak's host port; the issuer address of the services (localhost:<port>) follows it.
KEYCLOAK_PORT=8081
# Keycloak (admin console, development password) listens on the loopback only; 0.0.0.0 opens it to the network
KEYCLOAK_BIND=127.0.0.1

# The host ports of docker-compose.dev.yml (Postgres, the Traefik dashboard, RustFS) listen on the loopback; 0.0.0.0 opens them
# to the network (a kind cluster needs it, infra/kind/README.md)
DEV_BIND=127.0.0.1

# The password of Valkey (the realtime relay). The default is a development value; the realtime service gets it through REDIS_URL
# (redis://:<password>@valkey:6379), and an app on the host needs it in apps/realtime/.env
VALKEY_PASSWORD=dev-only-valkey-password

# Sign in with Microsoft Entra ID (docs/self-hosting.md, ADR 0027). Keycloak reads these when it imports the realm, so they take effect
# on a fresh Keycloak database. The defaults (nothing set here) are the stand-in, the realm `entra-stub` of the same Keycloak: sign in
# as erika (password erika) with the "Microsoft" button. For a tenant, set all of them (replace <tenant id>, the object id of the
# administrators group and the client of your app registration):
#   ENTRA_ENABLED=true
#   ENTRA_CLIENT_ID=<application (client) id>
#   ENTRA_CLIENT_SECRET=<a client secret of the app registration>
#   ENTRA_ISSUER_URL=https://login.microsoftonline.com/<tenant id>/v2.0
#   ENTRA_AUTH_URL=https://login.microsoftonline.com/<tenant id>/oauth2/v2.0/authorize
#   ENTRA_TOKEN_URL=https://login.microsoftonline.com/<tenant id>/oauth2/v2.0/token
#   ENTRA_JWKS_URL=https://login.microsoftonline.com/<tenant id>/discovery/v2.0/keys
#   ENTRA_ADMIN_GROUP_ID=<object id of the group whose members administer Elysion>

# Edge: the origins that get CORS headers, and the rate limit per client address and second (docs/specs/gateway.md).
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:4200
RATE_LIMIT_AVERAGE=50
RATE_LIMIT_BURST=100
# The public API (/public/v1, ADR 0033): requests per minute and token, counted by the BFF and announced in RateLimit-* headers;
# and the edge's flood guard, requests per minute and client address, with its burst.
PUBLIC_API_RATE_LIMIT_PER_MINUTE=600
PUBLIC_API_IP_RATE_LIMIT_AVERAGE=1200
PUBLIC_API_IP_RATE_LIMIT_BURST=120
# The frontend's Content-Security-Policy: off, report or enforce; Strict-Transport-Security in seconds (only with TLS).
CSP_MODE=enforce
HSTS_MAX_AGE=

# Only with docker-compose.dev.yml (working on Elysion): the host ports of Valkey and of RustFS (the files of boards, #702).
VALKEY_PORT=6380
RUSTFS_S3_PORT=9100
RUSTFS_CONSOLE_PORT=9101
# Only with docker-compose.dev.yml: the host ports of the log viewer (`pnpm dev:logs`, the Aspire dashboard): its UI and its OTLP/HTTP endpoint.
ASPIRE_DASHBOARD_PORT=18888
ASPIRE_DASHBOARD_OTLP_PORT=18890
# The object store of board files (#702): the development values are the defaults of docker-compose.yml.
# S3_BUCKET=elysion-files
# S3_ACCESS_KEY=elysion
# S3_SECRET_KEY=elysion123
# MAX_FILE_BYTES=10485760
# MAX_FILES_PER_BOARD=200

# What one person may keep; over a quota a request is answered 409 (docs/specs/business-backend.md, "Quotas")
# MAX_TEMPLATES_PER_USER=100
# MAX_TEMPLATE_CHARACTERS_PER_USER=20000000
# MAX_BOARDS_PER_USER=1000

# How many days the audit log keeps who gave or took away access (docs/specs/business-backend.md, "Audit log"); older entries go every night
# AUDIT_RETENTION_DAYS=365

# The optional second source of group members (#667): Microsoft Graph reads the linked groups, so that a group is complete before its
# people have signed in. Off unless all three are set. Application permission GroupMember.Read.All with admin consent (docs/self-hosting.md).
# GRAPH_SYNC_INTERVAL is in minutes (at least 5).
# GRAPH_TENANT_ID=
# GRAPH_CLIENT_ID=
# GRAPH_CLIENT_SECRET=
# GRAPH_SYNC_INTERVAL=60

# The backup service (profile `backup`, docs/self-hosting.md): when it runs (cron syntax), how many days of runs it keeps, and
# where they go (a named volume by default; a host path such as /srv/elysion-backups to keep them outside Docker).
# BACKUP_CRON=0 3 * * *
# BACKUP_KEEP_DAYS=14
# BACKUP_PATH=backup-data

# The realtime service's limits on a board's document (ADR 0026, docs/specs/realtime.md "Limits"), in bytes: one Yjs update,
# the whole encoded board, and the size above which an idle board is rebuilt (0: never). The defaults are these values.
MAX_UPDATE_BYTES=2097152
MAX_DOCUMENT_BYTES=8388608
COMPACT_THRESHOLD_BYTES=1048576

# Optional: send people straight to the company login (the alias of the realm's identity provider). Empty: Keycloak's own page.
# AUTH_IDP_HINT=microsoft

# Copy to infra/docker/.env to move a service when its default host port is taken on your machine
# (compose reads .env next to docker-compose.yml). Defaults shown.
REDIS_PORT=6379
RUSTFS_S3_PORT=9000
RUSTFS_CONSOLE_PORT=9001
# After changing REDIS_PORT, start apps/realtime with a matching REDIS_URL, e.g. redis://localhost:6380

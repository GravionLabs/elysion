{
  "realm": "elysion",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "board-user",
        "description": "Can create and open boards"
      },
      {
        "name": "elysion-admin",
        "description": "Administers users, groups, rooms and boards (never reads a board's content), ADR 0027"
      },
      {
        "name": "elysion-integration",
        "description": "A Keycloak service account that is an Elysion integration: accepted on the public API (/public/v1) only, ADR 0033"
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-elysion"
  },
  "clients": [
    {
      "clientId": "elysion-frontend",
      "name": "Elysion frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": ["http://localhost:4200/*", "http://localhost/*"],
      "webOrigins": ["http://localhost:4200", "http://localhost"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*##http://localhost/*"
      },
      "protocolMappers": [
        {
          "name": "audience-elysion-bff",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "elysion-bff",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "groups",
            "claim.name": "groups",
            "jsonType.label": "String",
            "multivalued": "true",
            "aggregate.attrs": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "elysion-bff",
      "name": "Elysion BFF",
      "enabled": true,
      "publicClient": false,
      "secret": "elysion-bff-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    },
    {
      "clientId": "elysion-integration-example",
      "name": "Example integration (development only, ADR 0033)",
      "description": "A script that uses the public API with the client-credentials grant; docs/api.md",
      "enabled": true,
      "publicClient": false,
      "secret": "elysion-integration-example-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect",
      "defaultClientScopes": ["basic", "profile", "roles", "web-origins", "acr", "service_account"],
      "optionalClientScopes": [
        "boards:read",
        "boards:write",
        "members:write",
        "snapshots:write",
        "webhooks:write"
      ],
      "protocolMappers": [
        {
          "name": "audience-elysion-bff",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "elysion-bff",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "dev",
      "email": "dev@elysion.local",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "User",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ],
      "realmRoles": ["board-user", "elysion-admin"]
    },
    {
      "username": "guest",
      "email": "guest@elysion.local",

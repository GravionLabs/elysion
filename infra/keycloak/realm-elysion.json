{
  "realm": "elysion",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "board-user",
        "description": "Can create and open boards"
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-elysion"
  },
  "clients": [
    {
      "clientId": "elysion-frontend",
      "name": "Elysion frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": ["http://localhost:4200/*", "http://localhost/*"],
      "webOrigins": ["http://localhost:4200", "http://localhost"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*##http://localhost/*"
      },
      "protocolMappers": [
        {
          "name": "audience-elysion-bff",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "elysion-bff",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "elysion-bff",
      "name": "Elysion BFF",
      "enabled": true,
      "publicClient": false,
      "secret": "elysion-bff-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "dev",
      "email": "dev@elysion.local",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "User",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ],
      "realmRoles": ["board-user"]
    },
    {
      "username": "guest",
      "email": "guest@elysion.local",
      "emailVerified": true,
      "firstName": "Guest",
      "lastName": "User",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "guest",
          "temporary": false
        }
      ],
      "realmRoles": ["board-user"]
    },
    {
      "username": "dev1",
      "email": "dev1@elysion.local",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "1",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev1",
          "temporary": false
        }
      ],
      "realmRoles": ["board-user"]
    },
    {
      "username": "dev2",
      "email": "dev2@elysion.local",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "2",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev2",
          "temporary": false
        }
      ],
      "realmRoles": ["board-user"]
    }
  ]
}

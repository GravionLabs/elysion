{
  "realm": "elysion",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "board-user",
        "description": "Can create and open boards"
      },
      {
        "name": "elysion-admin",
        "description": "Administers users, groups, rooms and boards (never reads a board's content), ADR 0027"
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-elysion"
  },
  "clients": [
    {
      "clientId": "elysion-frontend",
      "name": "Elysion frontend",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocol": "openid-connect",
      "redirectUris": ["http://localhost:4200/*", "http://localhost/*"],
      "webOrigins": ["http://localhost:4200", "http://localhost"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:4200/*##http://localhost/*"
      },
      "protocolMappers": [
        {
          "name": "audience-elysion-bff",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "elysion-bff",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "consentRequired": false,
          "config": {
            "user.attribute": "groups",
            "claim.name": "groups",
            "jsonType.label": "String",
            "multivalued": "true",
            "aggregate.attrs": "true",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "userinfo.token.claim": "false"
          }
        }
      ]
    },
    {
      "clientId": "elysion-bff",
      "name": "Elysion BFF",
      "enabled": true,
      "publicClient": false,
      "secret": "elysion-bff-dev-secret",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "dev",
      "email": "dev@elysion.local",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "User",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ],
      "realmRoles": ["board-user", "elysion-admin"]
    },
    {
      "username": "guest",
      "email": "guest@elysion.local",
      "emailVerified": true,
      "firstName": "Guest",
      "lastName": "User",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "guest",
          "temporary": false
        }
      ],
      "realmRoles": ["board-user"]
    },
    {
      "username": "dev1",
      "email": "dev1@elysion.local",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "1",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev1",
          "temporary": false
        }
      ],
      "realmRoles": ["board-user"]
    },
    {
      "username": "dev2",
      "email": "dev2@elysion.local",
      "emailVerified": true,
      "firstName": "Dev",
      "lastName": "2",
      "enabled": true,
      "credentials": [
        {
          "type": "password",
          "value": "dev2",
          "temporary": false
        }
      ],
      "realmRoles": ["board-user"]
    }
  ],
  "ssoSessionMaxLifespan": 28800,
  "attributes": {},
  "authenticationFlows": [
    {
      "alias": "elysion first broker login",
      "description": "Creates the user, or links the person to the user with the same e-mail address (ADR 0027)",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "authenticator": "idp-create-user-if-unique",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false
        },
        {
          "authenticator": "idp-auto-link",
          "authenticatorFlow": false,
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false
        }
      ]
    }
  ],
  "identityProviders": [
    {
      "alias": "microsoft",
      "displayName": "Microsoft",
      "providerId": "oidc",
      "enabled": "${ENTRA_ENABLED:false}",
      "trustEmail": true,
      "storeToken": false,
      "addReadTokenRoleOnCreate": false,
      "authenticateByDefault": false,
      "linkOnly": false,
      "firstBrokerLoginFlowAlias": "elysion first broker login",
      "config": {
        "clientId": "${ENTRA_CLIENT_ID:not-configured}",
        "clientSecret": "${ENTRA_CLIENT_SECRET:not-configured}",
        "clientAuthMethod": "client_secret_post",
        "authorizationUrl": "${ENTRA_AUTH_URL:https://login.microsoftonline.com/organizations/oauth2/v2.0/authorize}",
        "tokenUrl": "${ENTRA_TOKEN_URL:https://login.microsoftonline.com/organizations/oauth2/v2.0/token}",
        "jwksUrl": "${ENTRA_JWKS_URL:https://login.microsoftonline.com/organizations/discovery/v2.0/keys}",
        "issuer": "${ENTRA_ISSUER_URL:https://login.microsoftonline.com/organizations/v2.0}",
        "useJwksUrl": "true",
        "validateSignature": "true",
        "defaultScope": "openid profile email",
        "syncMode": "FORCE",
        "pkceEnabled": "false"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "groups",
      "identityProviderAlias": "microsoft",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "claim": "groups",
        "user.attribute": "groups"
      }
    },
    {
      "name": "administrators",
      "identityProviderAlias": "microsoft",
      "identityProviderMapper": "oidc-advanced-role-idp-mapper",
      "config": {
        "syncMode": "FORCE",
        "are.claim.values.regex": "false",
        "claims": "[{\"key\": \"groups\", \"value\": \"${ENTRA_ADMIN_GROUP_ID:00000000-0000-0000-0000-000000000000}\"}]",
        "role": "elysion-admin"
      }
    }
  ]
}

{
  "name": "elysion",
  "private": true,
  "version": "0.0.0",
  "description": "Open-source Mural alternative (Angular, React/tldraw, NestJS, Yjs, .NET)",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "test": "pnpm -r --if-present run test",
    "lint": "pnpm -r --if-present run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:infra": "docker compose -f infra/docker/docker-compose.yml up -d",
    "dev:infra:down": "docker compose -f infra/docker/docker-compose.yml down"
  },
  "devDependencies": {
    "prettier": "^3.8.1"
  }
}

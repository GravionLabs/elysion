{
  "name": "elysion",
  "private": true,
  "version": "0.0.0",
  "description": "Open-source Mural alternative (Angular, React/tldraw, NestJS, Yjs, .NET)",
  "license": "MIT",
  "packageManager": "pnpm@12.3.4+sha512.961aa41fb077da3a04a441d9f8e15ebc0c96da8ef710b2eb67bf9ee7cb0610eabd48f1fd85f51cffe73846785fa0f87c56a3a872a1d893f8446741b5cce45457",
  "scripts": {
    "build": "pnpm -r --if-present run build && pnpm build:dotnet",
    "build:dotnet": "node apps/business-backend/run-dotnet.mjs build",
    "test": "pnpm -r --if-present run test && pnpm test:dotnet && pnpm test:repo",
    "test:dotnet": "node apps/business-backend/run-dotnet.mjs test",
    "test:repo": "node --test \".github/scripts/*.test.mjs\"",
    "lint": "pnpm -r --if-present run lint && pnpm lint:dotnet",
    "lint:dotnet": "node apps/business-backend/run-dotnet.mjs lint",
    "format:dotnet": "node apps/business-backend/run-dotnet.mjs format",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup:env": "node scripts/setup-dev-env.mjs",
    "dev:infra": "node scripts/setup-dev-env.mjs && docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d traefik postgres keycloak valkey rustfs",
    "dev:infra:down": "docker compose -f docker-compose.yml -f docker-compose.dev.yml down",
    "dev:stack": "node scripts/dev-stack.mjs up",
    "dev:logs": "node scripts/dev-stack.mjs logs",
    "demo": "docker compose up -d --build",
    "demo:check": "bash scripts/demo-smoke.sh",
    "test:browser": "pnpm --filter @elysion/e2e test:browser",
    "demo:down": "docker compose down",
    "dev:observability": "node scripts/dev-stack.mjs observability",
    "dev:stack:down": "node scripts/dev-stack.mjs down",
    "make:icons": "node scripts/make-icons.mjs",
    "kind:up": "bash infra/kind/deploy.sh up",
    "kind:down": "bash infra/kind/deploy.sh down",
    "prepare": "simple-git-hooks"
  },
  "devDependencies": {
    "lib0": "^0.2.119",
    "lint-staged": "^17.6.0",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "sharp": "^0.35.5",
    "simple-git-hooks": "^2.14.0",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  }
}

{
  "name": "@elysion/frontend-canvas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "build:element": "tsc -p tsconfig.json --noEmit && vite build --config vite.element.config.ts",
    "build:element:watch": "vite build --watch --config vite.element.config.ts",
    "test": "vitest run",
    "preview": "vite preview",
    "lint": "oxlint -c oxlint.json src/"
  },
  "dependencies": {
    "@elysion/design-tokens": "workspace:*",
    "@excalidraw/excalidraw": "^0.18.1",
    "lib0": "^0.2.117",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^28.0.0",
    "oxlint": "^1.58.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.2",
    "vite-plugin-css-injected-by-js": "^5.0.2",
    "vitest": "^4.0.8",
    "vitest-canvas-mock": "^1.2.0",
    "ws": "^8.21.3"
  }
}

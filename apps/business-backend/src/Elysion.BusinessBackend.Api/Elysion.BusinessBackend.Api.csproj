<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <!-- `pnpm setup:env` stores the INTERNAL_API_SECRET shared with the realtime service in the user secrets. -->
    <UserSecretsId>elysion-business-backend</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Ardalis.GuardClauses" />
    <PackageReference Include="AWSSDK.S3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Npgsql 10.0.3 pulls Relational 10.0.4; pin it to the version of the other EF packages. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="prometheus-net.AspNetCore" />
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Sinks.OpenTelemetry" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates\*.excalidraw" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Elysion.BusinessBackend.Tests" />
  </ItemGroup>

</Project>

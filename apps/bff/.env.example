# Copy to apps/bff/.env for local runs (`pnpm --filter @elysion/bff start`). Names and meaning:
# docs/specs/identity.md. Development values only: never use these secrets anywhere else.

PORT=3000
BUSINESS_BACKEND_URL=http://localhost:5174

# Keycloak from `pnpm dev:infra` (ADR 0014).
OIDC_ISSUER_URL=http://localhost:8081/realms/elysion
OIDC_AUDIENCE=elysion-bff
# Only needed where Keycloak is reached at another address than the issuer's (inside the compose network):
# OIDC_JWKS_URI=http://keycloak:8080/realms/elysion/protocol/openid-connect/certs

# Required. Shared with the realtime service; at least 32 characters.
WS_TOKEN_SECRET=dev-only-ws-token-secret-change-me-0123456789
WS_TOKEN_TTL_SECONDS=60

# Logs (ADR 0025): trace, debug, info, warn, error or fatal; json or text (unset: text in a terminal, json in a container).
LOG_LEVEL=info
# LOG_FORMAT=json
# Also send every log line to the log viewer of `pnpm dev:logs` (VictoriaLogs, OTLP over HTTP); off when unset.
# OTEL_EXPORTER_OTLP_LOGS_ENDPOINT=http://localhost:9428/insert/opentelemetry/v1/logs

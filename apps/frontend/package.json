{
  "name": "@elysion/frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "pnpm --filter @elysion/frontend-canvas build:element && rm -rf public/canvas && mkdir -p public/canvas && cp -r ../frontend-canvas/dist-element/. public/canvas/",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "lint": "oxlint --deny-warnings src/ && eslint \"src/**/*.html\" && node --test lint-probe/probe.test.mjs",
    "i18n:extract": "ng extract-i18n"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/localize": "^22.2.2",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@elysion/design-tokens": "workspace:*",
    "angular-auth-oidc-client": "22.0.1",
    "pdf-lib": "^1.17.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "22.8.0",
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@types/node": "^26.6.6",
    "angular-eslint": "^22.8.0",
    "eslint": "^10.15.0",
    "jsdom": "^28.0.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5"
  }
}

# Copy to apps/realtime/.env for local runs (`PORT=3001 pnpm --filter @elysion/realtime start`). Names and meaning:
# docs/specs/identity.md. Development values only: never use these secrets anywhere else.

PORT=3000
REDIS_URL=redis://localhost:6379
BUSINESS_BACKEND_URL=http://localhost:5174

# Required. Verifies the WS tokens the BFF issues; the same value as in apps/bff/.env, at least 32 characters.
WS_TOKEN_SECRET=dev-only-ws-token-secret-change-me-0123456789

# Required. Signs the short-lived token this service presents to the business backend's internal document API
# (ADR 0017); the same value as the backend's `INTERNAL_API_SECRET`, at least 32 characters, and never the same
# value as WS_TOKEN_SECRET.
INTERNAL_API_SECRET=dev-only-internal-api-secret-change-me-0123456789

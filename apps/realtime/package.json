    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "lib0": "^0.2.119",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ws": "^8.22.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.8",
